# Cliente REST de VS Code. Ejecutar las peticiones de planificación en orden.
@base = http://localhost:8089
@planId = {{crearPlan.response.body.$.id}}

### Listar planificaciones
GET {{base}}/api/planificaciones

### Crear un ejemplo y capturar el id devuelto
# @name crearPlan
POST {{base}}/api/planificaciones
Content-Type: application/json

{
  "asignatura": "Lenguaje",
  "unidad": "Unidad ficticia",
  "objetivo": "OA lectura",
  "tipoRecurso": "Texto",
  "titulo": "DSY1105-EJEMPLO",
  "descripcion": "Lectura inicial",
  "validado": true,
  "enviadoUtp": true,
  "autorizado": false,
  "asignadoAlumno": false,
  "respuestaEntregada": false,
  "respuestaAlumno": ""
}

### Recuperar el ejemplo creado
GET {{base}}/api/planificaciones/{{planId}}

### Actualizar el ejemplo completo
PUT {{base}}/api/planificaciones/{{planId}}
Content-Type: application/json

{
  "asignatura": "Lenguaje",
  "unidad": "Unidad ficticia",
  "objetivo": "OA lectura",
  "tipoRecurso": "Texto",
  "titulo": "DSY1105-EJEMPLO",
  "descripcion": "Lectura modificada",
  "validado": true,
  "enviadoUtp": true,
  "autorizado": true,
  "asignadoAlumno": false,
  "respuestaEntregada": false,
  "respuestaAlumno": ""
}

### Eliminar exclusivamente el ejemplo creado en esta sesión
DELETE {{base}}/api/planificaciones/{{planId}}

### Confirmar 404 tras la eliminación
GET {{base}}/api/planificaciones/{{planId}}

### Consultar configuración antes de cualquier escritura
GET {{base}}/api/configuracion-examen

### Crear configuración (ejecutar solo en base de prácticas vacía)
PUT {{base}}/api/configuracion-examen
Content-Type: application/json

{
  "intentosPermitidos": 2,
  "fechaInicio": "01/11/2026",
  "fechaFin": "15/11/2026",
  "version": "DSY1105-EJEMPLO-A"
}

### Actualizar la configuración ficticia propia y comparar el id
PUT {{base}}/api/configuracion-examen
Content-Type: application/json

{
  "intentosPermitidos": 3,
  "fechaInicio": "01/11/2026",
  "fechaFin": "15/11/2026",
  "version": "DSY1105-EJEMPLO-B"
}

### Confirmar la configuración guardada
GET {{base}}/api/configuracion-examen
